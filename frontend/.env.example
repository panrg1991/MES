# =============================================================================
# MES 前端环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为 .env（开发）或 .env.production（生产构建时自动读取）
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# 注意：Vite 只会暴露以 VITE_ 开头的变量给客户端代码，
#      且环境变量在**构建时**被静态替换。
#
# ★ 生产部署推荐：保持本文件默认值构建，部署后通过 dist/config.js 修改后端地址，
#   同一份 dist 可在不同环境间复用，无需重新构建（详见 README §5）。
# =============================================================================

# -----------------------------------------------------------------------------
# 后端 API 基地址（构建期默认值，可被部署后的 config.js 覆盖）
#   ① 开发环境（Vite 代理，推荐）：/api
#      → vite.config.ts 把 /api 代理到 VITE_DEV_PROXY_TARGET，无需跨域
#   ② 前后端分离部署（Nginx 反代同源）：/api
#   ③ 前后端不同域名/IP：http://192.168.1.100:3000/api
#      → 此时后端 .env 的 CORS_ORIGIN 必须包含本前端的来源，否则被 CORS 拦截
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api

# 应用标题（显示在浏览器标签与登录页，可选）
VITE_APP_TITLE=MES 车间制造执行系统

# -----------------------------------------------------------------------------
# 部署基路径（子目录部署时使用）
#   根目录部署（http://host/）        ：留空或 /
#   子目录部署（http://host/mes/）    ：/mes/   （必须以 / 开头、以 / 结尾）
# 说明：配置后需重新构建（Vite 会按该值重写资源引用路径），
#      同时把部署后 config.js 的 BASE_PATH 设为同值。
# -----------------------------------------------------------------------------
# VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# 开发期代理目标（仅 npm run dev 生效；后端不在本机时修改）
# -----------------------------------------------------------------------------
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
