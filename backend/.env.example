# =============================================================================
# MES 后端环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制为 .env（开发）或 .env.production（生产），按需修改
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# 加载规则（见 src/config/env.js）：
#   NODE_ENV=production → 读取 .env.production
#   其他（含未设置）    → 读取 .env
#
# 数据库切换：只需修改 DB_TYPE（及对应连接参数），然后执行
#   npm run db:setup:sqlite   或   npm run db:setup:mysql
# 业务代码零改动。详见 backend/docs/DATABASE.md
#
# 安全提示：本文件只放占位值，**不要**把真实密钥写进仓库。
# =============================================================================

# ---------------------------- 基础配置 ----------------------------

# 服务监听端口（默认 3000）
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# ---------------------------- 数据库动态配置 ----------------------------
# DB_TYPE：sqlite | mysql（二选一，必填项；缺省按 DATABASE_URL 推断，再缺省为 sqlite）
DB_TYPE=sqlite

# ---- 方式一：SQLite（默认，单机 / 内网小规模首选）----
# 数据库文件路径，相对于 backend/prisma/ 目录
DB_PATH=./dev.db

# ---- 方式二：MySQL 8.0 / MariaDB 10.3+ ----
# 使用 MySQL 时：把 DB_TYPE 改为 mysql，并填写以下 5 项（密码含特殊字符会自动 URL 编码）
# DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mes_user
DB_PASSWORD=CHANGE_ME
DB_NAME=mes_workshop

# ---- 方式三：直接给出整串连接串（可选）----
# 若 DATABASE_URL 与 DB_TYPE 类型一致则优先使用它；类型不一致时以 DB_TYPE 为准重新拼装。
# 留空即可，脚本会按上面的分散参数自动拼装。
# DATABASE_URL="file:./dev.db"
# DATABASE_URL="mysql://mes_user:CHANGE_ME@127.0.0.1:3306/mes_workshop"

# 启动时是否自动写入种子数据（空库初始化用；默认 false，避免覆盖已有数据）
AUTO_SEED=false

# ---------------------------- JWT 认证 ----------------------------
# 【生产环境必须修改】两项密钥都必须替换为强随机值（建议 32 字节以上，例如 openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
# Access Token 有效期（默认 2h）
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_RANDOM_REFRESH_SECRET
# Refresh Token 有效期（默认 7d）
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------- 跨域与请求体 ----------------------------
# 允许的前端来源：多个用英文逗号分隔；设为 * 表示不限制（内网可信环境可用）
CORS_ORIGIN=http://localhost:5173

# 请求体大小上限（MB，默认 10）
BODY_LIMIT=10
