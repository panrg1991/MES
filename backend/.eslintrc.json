{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "caughtErrors": "none" }]
  },
  "ignorePatterns": [
    "node_modules/",
    "prisma/generated/",
    "backups/",
    "logs/",
    "coverage/"
  ],
  "overrides": [
    {
      "files": ["tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true
      }
    }
  ]
}
