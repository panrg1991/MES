{
  "name": "mes-backend",
  "version": "2.0.0",
  "description": "MES 车间制造执行系统 - 后端 API（支持 SQLite / MySQL 动态配置）",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "db:status": "node scripts/db-setup.js --status",
    "db:setup": "node scripts/db-setup.js",
    "db:setup:sqlite": "node scripts/db-setup.js sqlite --push --seed",
    "db:setup:mysql": "node scripts/db-setup.js mysql --push --seed",
    "db:setup:all": "node scripts/db-setup.js all",
    "db:push": "node scripts/db-setup.js --push",
    "db:seed": "node prisma/seed.js",
    "db:backup": "node scripts/backup-db.js",
    "prisma:studio": "prisma studio",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prisma": "^5.9.1",
    "supertest": "^7.0.0"
  }
}
