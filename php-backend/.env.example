# ---------------------------------------------------------------------------
# MES 系统 - PHP 后端配置示例
#
# 【选文件规则，与 Node 端完全一致】
#   NODE_ENV=production → 读 .env.production；其他 → 读 .env
#   查找顺序：php-backend/<env> > backend/<env>；真实环境变量优先级最高。
#   注意：NODE_ENV 必须在「真实环境变量」中设置（系统环境变量 / php-fpm env /
#         Apache SetEnv），写在 .env 文件里不会影响选哪个文件 —— 与 Node 端一致。
#
# 【生产必做】
#   1) 在服务器上创建 php-backend/.env.production（或复用 backend/.env.production），
#      生产缺少该文件时 PHP 后端会直接返回 503 拒绝启动，避免连错库 / 用弱密钥；
#   2) JWT_SECRET / JWT_REFRESH_SECRET 必须与 Node 端一致，且长度 ≥ 32 位、两把不同；
#   3) 反向代理（Nginx/Apache）前置时必须设置 TRUST_PROXY=true，否则所有请求 IP
#      都会是 127.0.0.1，限流会误伤整个车间且审计日志 IP 全部失真。
#
# 安全说明：本文件只放占位值，真实密钥不要进仓库（.env* 已在 .gitignore 中）。
# ---------------------------------------------------------------------------

# 运行环境：development | production（建议在系统环境变量中设置）
# NODE_ENV=production

# 是否向前端返回异常详情：仅本地排障时设 true；未设置时只有在 NODE_ENV=development 下才开启
# APP_DEBUG=false

# 反向代理信任：false（直连）| true/1（单层 Nginx，取 X-Forwarded-For）
# TRUST_PROXY=false

# 数据库：mysql | sqlite（不填则按 DATABASE_URL / DB_PATH 推断）
# 生产建议使用最小权限账号（仅 SELECT/INSERT/UPDATE/DELETE），
# 建表/改表由迁移账号或 root 执行，见 database/mes-mysql-grants.sql
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=mes_app
# DB_PASSWORD=
# DB_NAME=mes_workshop

# SQLite（相对路径基准为 backend/prisma，与 Node 端一致）
# DB_TYPE=sqlite
# DB_PATH=./dev.db

# 也可直接使用连接串
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/mes_workshop

# JWT 密钥：必须与 backend/.env 中的值完全一致
# JWT_SECRET=请填写与后端相同的密钥
# JWT_REFRESH_SECRET=请填写与后端相同的刷新密钥
# JWT_EXPIRES_IN=2h
# JWT_REFRESH_EXPIRES_IN=7d

# 跨域来源（逗号分隔），需包含前端实际访问地址
# CORS_ORIGIN=http://localhost:5173

# 本地时区（影响“今天”的统计口径与日期分组）
# APP_TIMEZONE=Asia/Shanghai

# 请求体大小上限（MB）
# BODY_LIMIT=10
