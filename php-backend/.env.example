# ---------------------------------------------------------------------------
# MES 系统 - PHP 后端配置示例
#
# 默认无需本文件：未创建 php-backend/.env 时，PHP 会自动复用 ../backend/.env，
# 从而与 Node 后端连接同一个数据库、使用同一组 JWT 密钥（切换后 Token 仍有效）。
#
# 仅在需要「独立于 Node 配置」时，才复制本文件为 .env 并取消对应注释。
# 注意：JWT_SECRET / JWT_REFRESH_SECRET 一旦与 Node 端不一致，切换后需重新登录。
# ---------------------------------------------------------------------------

# 运行环境：development | production（生产必须为 production）
# NODE_ENV=production

# 数据库：mysql | sqlite（不填则按 DATABASE_URL / DB_PATH 推断）
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=mes_workshop

# SQLite（相对路径基准为 backend/prisma，与 Node 端一致）
# DB_TYPE=sqlite
# DB_PATH=./dev.db

# 也可直接使用连接串
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/mes_workshop

# JWT 密钥：必须与 backend/.env 中的值完全一致
# JWT_SECRET=请填写与后端相同的密钥
# JWT_REFRESH_SECRET=请填写与后端相同的刷新密钥
# JWT_EXPIRES_IN=2h
# JWT_REFRESH_EXPIRES_IN=7d

# 跨域来源（逗号分隔），需包含前端实际访问地址
# CORS_ORIGIN=http://localhost:5173

# 本地时区（影响“今天”的统计口径与日期分组）
# APP_TIMEZONE=Asia/Shanghai

# 请求体大小上限（MB）
# BODY_LIMIT=10
